<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Everything else Foreman signs (build.mac.entitlementsInherit): Electron's helper apps and frameworks, node-pty's
     spawn-helper and the native modules. The renderer helper runs V8; nothing else needs an entitlement. The agents'
     own executables keep their vendors' signatures and entitlements (build.mac.signIgnore). -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
