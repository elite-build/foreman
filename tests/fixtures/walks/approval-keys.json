{
  "name": "approval-keys",
  "steps": [
    { "key": "F6", "expect": { "focus": { "role": "group", "name": "^Run this command\\?$", "tag": "^section$" } } },
    { "key": "Tab", "expect": { "focus": { "role": "textbox", "name": "^Tell the agent what to do instead", "tag": "^input$" } } },
    { "key": "Tab", "expect": { "focus": { "role": "button", "name": "^Full request$", "tag": "^button$" } } },
    { "key": "Tab", "expect": { "focus": { "role": "button", "name": "^Don’t run\\b", "tag": "^button$" } } },
    { "key": "Enter", "expect": { "absent": [".approval-panel"] } }
  ]
}
