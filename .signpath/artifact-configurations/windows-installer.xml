<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the NSIS installer, Foreman-Setup-<version>.exe, signed after it has been built
  from the already signed Foreman.exe. Its slug in SignPath is the repository variable
  SIGNPATH_INSTALLER_CONFIGURATION_SLUG. SignPath keeps the configuration it uses; this copy is for review, so keep the
  two the same (see CODE_SIGNING.md).

  The Installers workflow uploads a ZIP holding only the installer. productVersion is the ProductVersion electron-builder
  writes into the installer: package.json's version as it is.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Foreman-Setup-*.exe" product-name="Foreman" product-version="${productVersion}">
      <authenticode-sign hash-algorithm="sha256" description="Foreman" description-url="https://github.com/elite-build/foreman" />
    </pe-file>
  </zip-file>
</artifact-configuration>
